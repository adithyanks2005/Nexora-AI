{
  "version": 2,
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://accounts.google.com https://cdn.jsdelivr.net; connect-src 'self' https://*.supabase.co https://accounts.google.com https://www.googleapis.com; form-action 'self'; upgrade-insecure-requests" }
      ]
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "api/index.py",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "src": "/manifest.webmanifest",
      "dest": "api/index.py",
      "headers": { "Cache-Control": "public, max-age=86400" }
    },
    {
      "src": "/service-worker.js",
      "dest": "api/index.py",
      "headers": { "Cache-Control": "no-store, max-age=0, must-revalidate" }
    },
    { "src": "/(.*)", "dest": "api/index.py" }
  ]
}
